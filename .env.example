# Copy to .env and set a random database password before docker compose up --build.
POSTGRES_PASSWORD=
WEB_PORT=8080
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
MANUAL_REFRESH_COOLDOWN=300
MOCK_SCENARIO=normal
DROM_ENABLED=false
AUTO_RU_ENABLED=false
JOB_TIMEOUT_SECONDS=90
SCHEDULER_ENABLED=true
SCHEDULER_JITTER_SECONDS=120
SOURCE_REQUEST_INTERVAL_SECONDS=2
SOURCE_REQUESTS_PER_HOUR=120
RETRY_BASE_SECONDS=60
MAX_JOB_ATTEMPTS=3
KNOWN_DETAIL_LIMIT=3
